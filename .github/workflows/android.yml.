name: Build Android APK
on:
  push: { branches: [main], paths: ['2_android/android/**', '.github/workflows/android.yml'] }
  pull_request: { paths: ['2_android/android/**'] }
  workflow_dispatch:
jobs:
  apk:
    runs-on: ubuntu-latest
    defaults: { run: { working-directory: 2_android/android } }
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: '17' }
      - name: Prepare preinstalled Android SDK
        run: |
          export ANDROID_HOME="${ANDROID_HOME:-/usr/local/lib/android/sdk}"
          echo "ANDROID_HOME=$ANDROID_HOME" >> "$GITHUB_ENV"
          SM="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
          [ -x "$SM" ] || SM="$(ls -d $ANDROID_HOME/cmdline-tools/*/bin/sdkmanager | head -1)"
          yes | "$SM" --licenses >/dev/null 2>&1 || true
          [ -d "$ANDROID_HOME/platforms/android-35" ] || "$SM" "platforms;android-35" "build-tools;35.0.0"
        working-directory: .
      - uses: gradle/actions/setup-gradle@v4
        with: { gradle-version: '8.9' }
      - run: gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: JKH-Android-debug-apk
          path: 2_android/android/app/build/outputs/apk/debug/app-debug.apk
